# ============================================================
# AI Lead Qualifier — Environment Variables
# ============================================================
# Copy this file to the appropriate location and fill in values.
# NEVER commit actual .env files to version control.
#
# trigger/.env       → used by the Trigger.dev task worker
# frontend/.env.local → used by the Next.js app (server-side only)
# ============================================================

# ------------------------------------------------------------
# Anthropic (Claude API)
# Get from: https://console.anthropic.com/settings/keys
# Used in: trigger/.env only
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Trigger.dev
# Get from: Trigger.dev dashboard → Project → API Keys
# Used in: trigger/.env AND frontend/.env.local
# NEVER expose this in client-side code or the browser bundle.
# ------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_sk_...

# ------------------------------------------------------------
# Trigger.dev Project Reference
# Get from: Trigger.dev dashboard → Project Settings
# Used in: trigger/trigger.config.ts (not an env var — just noted here)
# Format: proj_xxxxxxxxxxxxxxxx
# ------------------------------------------------------------
# TRIGGER_PROJECT_REF=proj_...
